# Database
# Get from: https://neon.tech or your Postgres provider
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM API Keys
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Get from: https://console.cloud.google.com/apis/credentials
# Must have YouTube Data API v3 enabled for date-bounded keyword discovery.
# Falls back to GOOGLE_API_KEY when unset.
# YOUTUBE_API_KEY=your_youtube_data_api_key_here

# LLM Settings
DEFAULT_LLM_MODEL=gemini-2.5-flash

# LangSmith (tracing)
# Get from: https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT="innie"

# Prefect Cloud (optional — only needed when deploying to Prefect Cloud)
# Get from: https://app.prefect.cloud/my/api-keys
PREFECT_API_KEY=pnu_...
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>

# LangGraph (classify_items agent)
# For local dev: http://localhost:2024 (run `langgraph dev` in agents/)
# For production: your LangGraph Cloud deployment URL
LANGGRAPH_API_URL=http://localhost:2024
# LANGGRAPH_API_KEY=

# Video scraping limits
MAX_VIDEOS_PER_KEYWORD=2
MAX_VIDEOS_PER_CREATOR=2
TRANSCRIPT_MAX_CHARS=1000

# Classification (multi-model voting)
# Comma-separated list of model values from agents/llm_factory.py AIModel enum
CLASSIFY_MODELS=gpt-4o,gpt-4o-mini,claude-sonnet-4-5,claude-haiku-4-5
CLASSIFY_TOTAL_INVOCATIONS=4
CLASSIFY_MAJORITY_THRESHOLD=0.75

# Connections
LAB_SERVER_URL=http://localhost:8100
REDIS_URL=redis://localhost:6379
