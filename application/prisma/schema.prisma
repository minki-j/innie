generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth Prisma Adapter) ───────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  reviews      Review[]
  funnels       Funnel[]
  trainingRuns TrainingRun[]
  ideaGraphs   IdeaGraph[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Video Data ───────────────────────────────────────────────

model Video {
  id              String   @id // YouTube video_id
  title           String
  description     String   @db.Text
  channelTitle    String
  channelId       String
  publishedAt     DateTime
  viewCount       BigInt   @default(0)
  likeCount       BigInt   @default(0)
  commentCount    BigInt   @default(0)
  durationSeconds Int
  definition      String   @default("hd")
  caption         String   @default("false")
  tags            String[]

  thumbnailDefault String?
  thumbnailMedium  String?
  thumbnailHigh    String?
  transcript       String?  @db.Text
  summary          String?  @db.Text

  reviews                Review[]
  funnelVideos           FunnelVideo[]
  channel                Channel?               @relation(fields: [channelId], references: [id])
  classNodeResults       ClassNodeResult[]
  classNodeModelVerdicts ClassNodeModelVerdict[]
  ideaGraphs             IdeaGraph[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@index([publishedAt])
}

model Channel {
  id              String  @id // YouTube channel_id
  title           String
  description     String? @db.Text
  customUrl       String?
  thumbnailUrl    String?
  subscriberCount BigInt  @default(0)
  videoCount      BigInt  @default(0)

  videos Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── App-Specific Data ────────────────────────────────────────

model Review {
  id      String  @id @default(cuid())
  userId  String
  videoId String
  funnelId String?
  rating  Int // 1-5
  content String? @db.Text

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  funnel Funnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId, funnelId]) // One review per user per video per funnel
  @@index([videoId])
  @@index([funnelId])
}

enum IdeaGraphGenerationStatus {
  IDLE
  GENERATING
  COMPLETED
  FAILED
}

enum IdeaGraphLayoutDirection {
  LR
  TB
}

enum IdeaGraphNodeType {
  CLAIM
  EVIDENCE
  COUNTERARGUMENT
  REBUTTAL
  EXAMPLE
  ASSUMPTION
  DEFINITION
  QUESTION
  CONCLUSION
}

enum IdeaGraphEdgeType {
  SUPPORTS
  ATTACKS
  REBUTS
  ELABORATES
  DEPENDS_ON
  ILLUSTRATES
  CONTRASTS_WITH
}

model IdeaGraph {
  id               String                    @id @default(cuid())
  userId           String
  videoId          String
  generationStatus IdeaGraphGenerationStatus @default(IDLE)
  generationError  String?                   @db.Text
  generatedAt      DateTime?
  layoutDirection  IdeaGraphLayoutDirection  @default(LR)
  visibleDepth     Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  nodes IdeaGraphNode[]
  edges IdeaGraphEdge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([videoId])
  @@index([userId, videoId, createdAt])
}

model IdeaGraphNode {
  id        String            @id @default(cuid())
  graphId   String
  type      IdeaGraphNodeType
  title     String            @default("")
  content   String?           @db.Text
  x         Float             @default(0)
  y         Float             @default(0)
  collapsed Boolean           @default(false)

  graph IdeaGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  outgoingEdges IdeaGraphEdge[]       @relation("IdeaGraphEdgeSource")
  incomingEdges IdeaGraphEdge[]       @relation("IdeaGraphEdgeTarget")
  transcriptSources IdeaGraphNodeSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([graphId])
}

model IdeaGraphEdge {
  id           String            @id @default(cuid())
  graphId      String
  sourceNodeId String
  targetNodeId String
  type         IdeaGraphEdgeType
  label        String?

  graph IdeaGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode IdeaGraphNode @relation("IdeaGraphEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode IdeaGraphNode @relation("IdeaGraphEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([graphId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model IdeaGraphNodeSource {
  id         String  @id @default(cuid())
  nodeId     String
  paraphrase String? @db.Text
  quote      String  @db.Text
  startSec   Float
  endSec     Float

  node IdeaGraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId])
}

// ─── Funnel ↔ Video Processing Status ────────────────────────

enum FunnelVideoStatus {
  PENDING       // linked to funnel, not yet queued
  PROCESSING    // pipeline is actively working on it
  PENDING_RETRY // failed but scheduled to retry
  FAILED        // permanently failed
  COMPLETED     // successfully processed
}

model FunnelVideo {
  funnelId String
  videoId  String
  status   FunnelVideoStatus @default(PENDING)

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([funnelId, videoId])
  @@index([funnelId, updatedAt])
  @@index([videoId])
}

// ───Classification ──────────────────────────────────────────────────

model Funnel {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  userId      String
  active      Boolean @default(true)

  pipelineIntervalHours Int       @default(6)
  lastPipelineRunAt     DateTime?

  maxVideosPerKeyword Int @default(20)
  maxVideosPerCreator Int @default(30)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords         FunnelKeyword[]
  creators         FunnelCreator[]
  funnelVideos     FunnelVideo[]

  classNodes       ClassNode[] @relation("FunnelClassNodes")

  reviews          Review[]
  trainingRuns     TrainingRun[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ClassNode {
  id          String  @id @default(cuid())
  title       String  @default("")
  description String? @db.Text

  parentClassNodeId  String?
  parentClassNode    ClassNode?  @relation("ParentClassNode", fields: [parentClassNodeId], references: [id])
  childrenClassNodes  ClassNode[] @relation("ParentClassNode")

  // TODO
  // mergeNodeChildId String?
  // mergeNodeChild MergeNode? @relation("MergeNodeChild", fields: [mergeNodeChildId], references: [id])
  // mergeNodeParentId String?
  // mergeNodeParent MergeNode? @relation("MergeNodeParent", fields: [mergeNodeParentId], references: [id])

  funnelId  String?
  funnel    Funnel?     @relation("FunnelClassNodes", fields: [funnelId], references: [id], onDelete: Cascade)

  results                ClassNodeResult[]      @relation("ClassNodeResults")
  goldStandards          GoldStandard[]         @relation("GoldStandardClassNode")
  classNodeModelVerdicts ClassNodeModelVerdict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId])
}

// TODO
// model MergeNode {
//   id        String  @id @default(cuid())
//   parentClassNodes ClassNode[] @relation("MergeNodeParent")
//   childClassNodes ClassNode[] @relation("MergeNodeChild")
// }

model GoldStandard {
  id         String  @id @default(cuid())
  classNodeId    String
  videoUrl   String
  title      String? // cached title for display
  isPositive Boolean @default(true) // true = positive, false = negative
  note       String? @db.Text

  classNode ClassNode @relation("GoldStandardClassNode", fields: [classNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classNodeId])
}

model FunnelKeyword {
  id      String @id @default(cuid())
  funnelId String
  keyword String

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId])
}

model FunnelCreator {
  id               String  @id @default(cuid())
  funnelId          String
  channelId        String?
  channelUrl       String?
  channelName      String?
  scrapeMonthsBack Int     @default(1) // 1-12

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId])
}

// ─── LLM Registry ────────────────────────────────────────────

model LLM {
  id       String @id // model API identifier, e.g. "gpt-4o", "claude-sonnet-4-6"
  provider String // "openai" | "anthropic"

  classNodeModelVerdicts ClassNodeModelVerdict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Criterion Results (Pipeline Output) ─────────────────────

enum ClassNodeResultValue {
  PASS
  FAIL
  CANNOT_TELL
}

model ClassNodeResult {
  id          String               @id @default(cuid())
  videoId     String
  classNodeId String
  result      ClassNodeResultValue
  confidence  Float
  explanation String?              @db.Text

  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  classNode ClassNode @relation("ClassNodeResults", fields: [classNodeId], references: [id], onDelete: Cascade)
  classNodeModelVerdicts ClassNodeModelVerdict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, classNodeId])
  @@index([videoId])
  @@index([classNodeId])
}

model ClassNodeModelVerdict {
  id                String          @id @default(cuid())
  videoId           String
  classNodeId       String
  classNodeResultId String
  llmId             String
  rationale         String          @db.Text
  verdict           Boolean

  video           Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  classNode       ClassNode       @relation(fields: [classNodeId], references: [id], onDelete: Cascade)
  classNodeResult ClassNodeResult @relation(fields: [classNodeResultId], references: [id], onDelete: Cascade)
  llm             LLM             @relation(fields: [llmId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, classNodeId, llmId])
  @@index([videoId])
  @@index([classNodeId])
  @@index([classNodeResultId])
  @@index([llmId])
}

// ─── Training (Lab Server) ───────────────────────────────────

enum TrainingStatus {
  PENDING
  TRAINING
  COMPLETED
  FAILED
  CANCELLED
}

enum TrainingMethod {
  SFT
  RLVR
}

model TrainingRun {
  id             String         @id @default(cuid())
  userId         String
  funnelId        String
  status         TrainingStatus @default(PENDING)
  method         TrainingMethod
  modelName      String         @unique // e.g. "innie-<topicId>-sft-v3"
  version        Int // auto-incremented per (userId, topicId, method)
  checkpointPath String? // Tinker checkpoint URI after completion
  baseModel      String         @default("meta-llama/Llama-3.1-8B-Instruct")
  config         Json? // training hyperparameters
  metrics        Json? // final training metrics
  datasetSize    Int? // number of training examples used
  webhookUrl     String?
  error          String?        @db.Text
  isActive       Boolean        @default(false) // is this the model to use for inference?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, funnelId])
  @@index([funnelId, method, isActive])
}
