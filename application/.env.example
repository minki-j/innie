# YouTube Data API Key
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_youtube_api_key_here

# NextAuth Configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Vercel Postgres (Neon)
# These are automatically set when you link a Vercel Postgres database.
# For local dev, run: npx vercel env pull .env.local
POSTGRES_PRISMA_URL=postgres://user:password@host:5432/dbname?sslmode=require&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/dbname?sslmode=require
